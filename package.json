{
  "name": "unbent",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "gate:offline": "node scripts/offline-gate.mjs",
    "dev:api": "pnpm --filter @unbent/api dev",
    "dev:api:watch": "pnpm --filter @unbent/api dev:watch",
    "dev:web": "pnpm --filter @unbent/web dev",
    "android": "apps/android/scripts/run.sh",
    "android:build": "apps/android/scripts/build-and-run.sh",
    "ios": "apps/ios/scripts/run.sh",
    "ios:build": "apps/ios/scripts/build-and-run.sh",
    "build": "pnpm --filter @unbent/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "worktree:setup": "scripts/worktree-setup.sh",
    "migrate:local": "pnpm --filter @unbent/api migrate:local",
    "migrate:remote": "pnpm --filter @unbent/api migrate:remote",
    "migrate:dev": "pnpm --filter @unbent/api migrate:dev",
    "seed:demo": "node scripts/seed-demo.mjs",
    "setup:instance": "node scripts/setup-instance.mjs",
    "release": "pnpm build && pnpm --filter @unbent/web sourcemaps && pnpm --filter @unbent/api release",
    "deploy": "pnpm migrate:remote && pnpm release"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.14.4",
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.4.2"
    },
    "patchedDependencies": {
      "@better-auth/kysely-adapter@1.7.7": "patches/@better-auth__kysely-adapter@1.7.7.patch"
    }
  }
}
