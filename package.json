{
  "name": "unbent",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @unbent/api dev",
    "dev:api:watch": "pnpm --filter @unbent/api dev:watch",
    "dev:web": "pnpm --filter @unbent/web dev",
    "android": "apps/android/scripts/run.sh",
    "android:build": "apps/android/scripts/build-and-run.sh",
    "build": "pnpm --filter @unbent/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "worktree:setup": "scripts/worktree-setup.sh",
    "migrate:local": "pnpm --filter @unbent/api migrate:local",
    "migrate:remote": "pnpm --filter @unbent/api migrate:remote",
    "migrate:dev": "pnpm --filter @unbent/api migrate:dev",
    "release": "pnpm build && pnpm --filter @unbent/web sourcemaps && pnpm --filter @unbent/api release"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.14.4"
}
