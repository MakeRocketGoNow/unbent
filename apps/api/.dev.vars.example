# Copy to .dev.vars for local development. .dev.vars is gitignored.

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# OAuth providers are optional in dev: a provider with no credentials is simply not
# offered, and the sign-in endpoint returns PROVIDER_NOT_FOUND. Configure at least one to
# exercise the real login flow.
#
# Callback URLs use the SPA origin (5173), not the Worker port: APP_URL is the SPA and the
# Vite proxy forwards /api to the Worker. In local dev Better Auth derives redirect_uri from
# the request Host, so Tailscale MagicDNS / 100.x work too — register each origin you use.
#
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:5173/api/auth/callback/google
#   (also add http://<tailscale-host>:5173/api/auth/callback/google if you sign in over Tailscale)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# GitHub:  https://github.com/settings/developers
#   Authorization callback URL: http://localhost:5173/api/auth/callback/github
#   (also add http://<tailscale-host>:5173/api/auth/callback/github if you sign in over Tailscale)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Enables password sign-up so the isolation suite can mint sessions without a live OAuth
# provider. Local development only — never set this in a deployed environment.
ALLOW_TEST_CREDENTIALS=1
