{
  "name": "@unbent/api",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local --port \"${API_PORT:-8787}\" --var \"APP_URL:http://localhost:${WEB_PORT:-5173}\" --var ALLOW_TEST_CREDENTIALS:1",
    "dev:watch": "until wrangler dev --env local --port \"${API_PORT:-8787}\" --var \"APP_URL:http://localhost:${WEB_PORT:-5173}\" --var ALLOW_TEST_CREDENTIALS:1; do echo 'wrangler exited, restarting'; sleep 1; done",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply DB --local --env local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --env \"\"",
    "migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "posttest": "./scripts/purge-test-data.sh",
    "purge-test-data": "./scripts/purge-test-data.sh",
    "db:reset": "./scripts/reset-local-db.sh",
    "reset:local": "./scripts/reset-local.sh",
    "release": "wrangler deploy --env \"\""
  },
  "dependencies": {
    "@better-auth/mcp": "^1.7.5",
    "@better-auth/oauth-provider": "^1.7.5",
    "@better-auth/passkey": "1.7.5",
    "@better-auth/utils": "0.4.2",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@unbent/enex": "workspace:*",
    "@unbent/shared": "workspace:*",
    "better-auth": "^1.7.5",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@zip.js/zip.js": "^2.15.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
