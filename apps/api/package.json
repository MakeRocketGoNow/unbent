{
  "name": "@unbent/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port \"${API_PORT:-8787}\" --var \"APP_URL:http://localhost:${WEB_PORT:-5173}\"",
    "dev:watch": "until wrangler dev --port \"${API_PORT:-8787}\" --var \"APP_URL:http://localhost:${WEB_PORT:-5173}\"; do echo 'wrangler exited, restarting'; sleep 1; done",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply unbent --local",
    "migrate:remote": "wrangler d1 migrations apply unbent --remote --env production",
    "migrate:dev": "wrangler d1 migrations apply unbent-dev --remote --env dev",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "posttest": "./scripts/purge-test-data.sh",
    "purge-test-data": "./scripts/purge-test-data.sh",
    "db:reset": "./scripts/reset-local-db.sh",
    "reset:local": "./scripts/reset-local.sh",
    "release": "wrangler deploy --env production"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.2",
    "@hono/zod-validator": "^0.9.1",
    "@unbent/enex": "workspace:*",
    "@unbent/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@zip.js/zip.js": "^2.11.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
