{
  "name": "@unbent/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:watch": "until wrangler dev; do echo 'wrangler exited, restarting'; sleep 1; done",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply unbent --local",
    "migrate:remote": "wrangler d1 migrations apply unbent --remote --env production",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "posttest": "./scripts/purge-test-data.sh",
    "purge-test-data": "./scripts/purge-test-data.sh",
    "db:reset": "./scripts/reset-local-db.sh",
    "reset:local": "./scripts/reset-local.sh",
    "release": "wrangler deploy --env production"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.2",
    "@hono/zod-validator": "^0.9.0",
    "@unbent/enex": "workspace:*",
    "@unbent/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "hono": "^4.11.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@zip.js/zip.js": "^2.8.55",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
