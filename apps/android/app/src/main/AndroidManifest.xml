<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        No foreground service, and nothing that asks to run one.

        Nothing in the app runs one: a capture is an ordinary WorkManager job, never
        expedited, and its progress is the notification POST_NOTIFICATIONS covers. The two
        FOREGROUND_SERVICE permissions declared here were written in anticipation of a
        foreground upload that never arrived.

        Removing them from this file is not enough. `work-runtime` declares
        FOREGROUND_SERVICE and its `SystemForegroundService` in its own manifest, and the
        merger adds both to every app that depends on WorkManager whether or not it calls
        `setForeground` — so this removal, and the matching one on the service inside
        `application` below, are what keep them out of the built app.

        Why bother: Play reads the merged manifest, and a foreground service there requires
        a declaration justified by a demo video showing a user-initiated, perceptible use.
        There is nothing to film, and the review would be answering for a capability the
        app does not have. If an upload ever does need to outlive the app being
        backgrounded, undoing these two removals is where that starts.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!--
        Android 11+ hides other packages unless declared. Sign-in with a provider that has
        no native sheet opens a Custom Tab, and without this the app finds no browser that
        supports them and silently falls back to an ordinary browser window.
    -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".UnbentApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unbent"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        tools:targetApi="31">

        <!--
            The other half of the foreground-service removal at the top of this file:
            WorkManager's own service, which the merger would otherwise contribute to an app
            that never starts it.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!--
            The app. One activity hosting the note list, an open note and settings.

            `singleTop` so a notification tapped while the app is open reaches onNewIntent
            instead of stacking a second copy. The configuration changes are handled rather
            than recreated because recreating the activity would recreate the WebView the
            editor lives in, and throw away its cursor and undo history mid-thought.
            `adjustResize` is what tells devices older than API 30 to report the keyboard as
            an inset, so the editor shrinks above it instead of being covered.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            The share-sheet entry: a bottom sheet over the sending app, with the title,
            notebook and tags, and one Save. Translucent so the sheet sits over whatever
            was being shared from; its own task so it never brings the note list with it.
            Not `noHistory`: a person who has to sign in first goes away and comes back,
            and the staged files must still be here when they do.
        -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Unbent.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            Exported, because the browser hands the token back by opening this deep link.
            The scheme carries the build's application id, so a debug install beside a
            release one cannot intercept the other's connection.
        -->
        <activity
            android:name=".ui.SignInActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/sign_in_title">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${connectScheme}" android:host="connect" />
            </intent-filter>
        </activity>

        <!--
            How a file the app made reaches the editor. The WebView's file chooser returns
            content URIs, and a HEIC photo the app has transcoded to JPEG has to come back
            as one too, so the JPEG is served from the cache through this provider. Not
            exported: the only reader is this app's own WebView, under a grant the
            provider issues per file. Paths in res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
