<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3 with Unbent's green substituted for the stock purple. Only the roles the
        app actually paints are overridden — buttons, their text, and the surfaces behind
        them — because a partial palette that leaves related roles at their defaults reads
        worse than either scheme on its own.
    -->
    <style name="Theme.Unbent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/unbent_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/unbent_green_container</item>
        <item name="colorOnPrimaryContainer">@color/unbent_green_dark</item>
        <item name="colorSecondary">@color/unbent_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <!--
        The share activity draws nothing: it stages files and finishes. A transparent,
        non-animated theme means the share sheet collapses straight back to the host app
        instead of flashing an empty screen.
    -->
    <style name="Theme.Unbent.Transparent" parent="Theme.Unbent">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
