<?xml version="1.0" encoding="utf-8"?>
<!--
  All notes, for the drawer: a sheet with a folded corner.

  Traced from lucide's `sticky-note`, the glyph the web app's drawer draws for the same row
  (`NotesRowIcon` in icons.tsx). The drawer's rows all carry a picture now, and these are
  drawn by hand for the reason `ic_filter` is: the core Material set lacks them and the
  extended set is thousands of icons for a handful of shapes. Stroked at 2dp on the 24dp
  grid, the weight of the Material glyphs they sit among.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:pathData="M21,9a2.4,2.4 0 0 0 -0.706,-1.706l-3.588,-3.588A2.4,2.4 0 0 0 15,3H5a2,2 0 0 0 -2,2v14a2,2 0 0 0 2,2h14a2,2 0 0 0 2,-2z"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M15,3v5a1,1 0 0 0 1,1h5"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
</vector>
