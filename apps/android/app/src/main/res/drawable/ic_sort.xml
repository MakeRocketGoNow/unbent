<?xml version="1.0" encoding="utf-8"?>
<!--
  The sort icon: two arrows, one up and one down.

  Drawn here because the core Material set has no sort glyph — the same trade `ic_filter`
  makes, and for the same reason: the extended set is thousands of icons for one shape.

  Traced from lucide's `arrow-up-down`, which is the icon the web app's list header draws
  for the same control (`SortIcon` in icons.tsx). One product, one picture for one idea:
  someone who learned the glyph on the site finds it on the phone. Stroked rather than
  filled, as lucide's are, at 2dp on the 24dp grid, which is also the weight of the
  Material glyphs beside it in the app bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:pathData="M21,16l-4,4l-4,-4"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M17,20V4"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M3,8l4,-4l4,4"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M7,4v16"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
</vector>
