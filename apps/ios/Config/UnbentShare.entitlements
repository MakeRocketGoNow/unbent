<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The one thing the extension shares with the app, and everything it needs: the
	  instance, the session in the Keychain, and the directory captures wait in.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(UNBENT_APP_GROUP)</string>
	</array>
</dict>
</plist>
