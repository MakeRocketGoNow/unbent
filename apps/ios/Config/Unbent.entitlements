<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(UNBENT_APP_GROUP)</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  The host whose links open in this app (applinks) and whose passkeys the system may
	  offer it (webcredentials). A claim, and only half of one: the instance has to list
	  the app in its apple-app-site-association before either happens, and it is that
	  document, not this file, that says which paths are the app's.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(UNBENT_INSTANCE_HOST)</string>
		<string>webcredentials:$(UNBENT_INSTANCE_HOST)</string>
	</array>
</dict>
</plist>
