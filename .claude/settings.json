{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/worktree-autosetup.sh",
            "timeout": 300,
            "statusMessage": "Setting up this worktree (dependencies, local database)…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/deny-emulator-launch.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
